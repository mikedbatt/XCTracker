# ── Firebase ──────────────────────────────────────────────────────────────────
# Get these from: https://console.firebase.google.com → Project Settings → General
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# ── Strava ────────────────────────────────────────────────────────────────────
# Only the client ID is needed in the app — the client secret is stored
# server-side in Firebase Functions config (firebase functions:config:set strava.client_secret="...")
EXPO_PUBLIC_STRAVA_CLIENT_ID=your_strava_client_id

# ── Web push (FCM) ────────────────────────────────────────────────────────────
# Required for browser push notifications. Get from Firebase Console →
# Project Settings → Cloud Messaging → Web configuration → Generate key pair.
# Without this set, web users won't receive push (native push is unaffected).
EXPO_PUBLIC_FIREBASE_VAPID_KEY=your_web_push_vapid_public_key

# ── Firebase App Check (web abuse protection) ────────────────────────────────
# reCAPTCHA ENTERPRISE site key (public) for App Check on web. Create a
# Website-type key in Google Cloud Console → Security → reCAPTCHA (Enterprise),
# then register it in Firebase Console → App Check → web app. When unset, App
# Check is skipped and the app boots normally (see firebaseConfig.js). Add the
# domains (xctracker.com, xctracker-a2532.web.app, localhost) to the key.
EXPO_PUBLIC_FIREBASE_APPCHECK_RECAPTCHA_KEY=your_recaptcha_enterprise_site_key

# ── Sentry (error + crash monitoring) ────────────────────────────────────────
# Get from sentry.io → Project Settings → Client Keys (DSN). Without this
# set, error reporting is silently disabled. See utils/sentry.js for setup.
EXPO_PUBLIC_SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project
