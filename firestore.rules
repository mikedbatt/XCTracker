rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Get the requesting user's Firestore profile
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if user belongs to the given school
    function belongsToSchool(schoolId) {
      return isSignedIn() && getUserData().schoolId == schoolId;
    }

    // Check if user is an APPROVED coach (admin or assistant) at the given
    // school. Pending assistant coaches (status 'pending') get no coach powers
    // until the head coach approves them. Missing status = legacy approved coach.
    function isCoachAtSchool(schoolId) {
      let user = getUserData();
      return isSignedIn()
        && schoolId != null
        && user.schoolId == schoolId
        && (user.role == 'admin_coach' || user.role == 'assistant_coach')
        && user.get('status', 'approved') == 'approved';
    }

    // Check if user is the HEAD coach (admin_coach only) at the given school.
    // Used to gate sensitive collections that assistant coaches should not see.
    function isHeadCoachAtSchool(schoolId) {
      let user = getUserData();
      return isSignedIn()
        && schoolId != null
        && user.schoolId == schoolId
        && user.role == 'admin_coach'
        && user.get('status', 'approved') == 'approved';
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    // Any signed-in user can read user docs. Needed for: parent link flow
    // (search by email), assistant coach join, teammate profiles, leaderboard.
    //
    // WRITES are field-restricted. `role`, `status`, `schoolId` & co. decide
    // what rules grant everywhere else (isCoachAtSchool, belongsToSchool), so a
    // user may only change them through the specific flows below — never by
    // editing their own doc freely (that let an athlete promote themselves to
    // head coach or approve themselves; 2026-10 audit).

    // Fields that only specific flows (or a coach / Cloud Function) may change.
    function userAccessKeys() {
      return ['role', 'status', 'schoolId', 'coachRole', 'trainingAccess',
              'groupId', 'linkedAthleteIds', 'latestRaceTimes',
              'schoolSourceAthleteId'];
    }

    // Owner edits that don't touch access fields: name, email, VDOT, push
    // tokens, seen/read markers, totalMiles. linkedParentIds may only shrink
    // (athlete removing a parent); additions come from the parentLinks flow.
    function ownerProfileEdit() {
      return !changedKeys().hasAny(userAccessKeys())
        && (!changedKeys().hasAny(['linkedParentIds'])
            || resource.data.get('linkedParentIds', [])
                 .hasAll(request.resource.data.get('linkedParentIds', [])));
    }

    // Athlete / assistant coach asks to join a school with its join code.
    // Always lands as 'pending' — only a coach can approve.
    function ownerJoinRequest() {
      let d = request.resource.data;
      return changedKeys().hasOnly(['schoolId', 'status', 'requestedAt', 'coachRole'])
        && d.status == 'pending'
        && d.schoolId is string
        && exists(/databases/$(database)/documents/schools/$(d.schoolId))
        && ((resource.data.role == 'athlete' && !changedKeys().hasAny(['coachRole']))
            || (resource.data.role == 'assistant_coach'
                && d.get('coachRole', 'assistant') == 'assistant'));
    }

    // "Leave team" — clear school membership.
    function ownerLeaveTeam() {
      let d = request.resource.data;
      return changedKeys().hasOnly(['schoolId', 'groupId', 'status'])
        && d.schoolId == null
        && d.get('groupId', null) == null
        && d.status == null;
    }

    // Head coach creates their school (CoachSetupScreen): doc id is fixed to
    // school_{uid}, so a coach can only ever own the school they created.
    function ownerCreateSchool() {
      let d = request.resource.data;
      return resource.data.role == 'admin_coach'
        && changedKeys().hasOnly(['schoolId', 'status', 'coachRole'])
        && d.schoolId == 'school_' + request.auth.uid
        && d.status == 'approved'
        && d.coachRole == 'admin';
    }

    // A linked parent picks up their athlete's school (when the athlete joined
    // a team after the link was approved). Must name a linked athlete whose
    // own school membership is approved, and copy exactly that school.
    function ownerParentAdoptsSchool() {
      let d = request.resource.data;
      let athlete = get(/databases/$(database)/documents/users/$(d.schoolSourceAthleteId)).data;
      return resource.data.role == 'parent'
        && changedKeys().hasOnly(['schoolId', 'status', 'schoolSourceAthleteId'])
        && d.schoolSourceAthleteId in resource.data.get('linkedAthleteIds', [])
        && athlete.get('status', null) == 'approved'
        && d.schoolId == athlete.schoolId
        && d.status == 'approved';
    }

    // Coach managing an athlete (or the head coach managing an assistant) at
    // their school: approve/deny/remove, groups, race times, training access.
    // Coaches can never change a role, and can only REMOVE someone from the
    // school (schoolId → null), never move them elsewhere.
    function coachManagesUser() {
      let target = resource.data;
      let d = request.resource.data;
      return ((target.role == 'athlete' && isCoachAtSchool(target.schoolId))
              || (target.role == 'assistant_coach' && isHeadCoachAtSchool(target.schoolId)))
        && changedKeys().hasOnly(['status', 'schoolId', 'groupId', 'trainingAccess',
                                  'coachRole', 'latestRaceTimes'])
        && (!changedKeys().hasAny(['schoolId']) || d.schoolId == null)
        && (!changedKeys().hasAny(['coachRole']) || d.coachRole == null || d.coachRole == 'assistant');
    }

    // An athlete removing a parent link also removes themselves from that
    // parent's linkedAthleteIds — removal of their OWN uid only.
    function athleteUnlinksFromParent() {
      let before = resource.data.get('linkedAthleteIds', []);
      let after = request.resource.data.get('linkedAthleteIds', []);
      return changedKeys().hasOnly(['linkedAthleteIds'])
        && request.auth.uid in before
        && !(request.auth.uid in after)
        && before.hasAll(after);
    }

    match /users/{userId} {
      // Signup: self-chosen role (head coach signup is open by design — see the
      // multi-school signup backlog), no school yet, and only head coaches
      // start out approved.
      allow create: if isOwner(userId)
        && request.resource.data.role in ['athlete', 'parent', 'admin_coach', 'assistant_coach']
        && request.resource.data.get('schoolId', null) == null
        && ((request.resource.data.role == 'admin_coach'
              && request.resource.data.get('status', null) == 'approved')
            || (request.resource.data.role != 'admin_coach'
              && request.resource.data.get('status', null) == 'pending'))
        && request.resource.data.get('coachRole', null) in [null, 'assistant']
        && !request.resource.data.keys().hasAny(['linkedAthleteIds', 'linkedParentIds',
             'groupId', 'trainingAccess', 'latestRaceTimes', 'schoolSourceAthleteId']);
      allow update: if isSignedIn()
        && ((isOwner(userId)
              && (ownerProfileEdit() || ownerJoinRequest() || ownerLeaveTeam()
                  || ownerCreateSchool() || ownerParentAdoptsSchool()))
            || coachManagesUser()
            || athleteUnlinksFromParent());
      allow read:   if isSignedIn();
      allow delete: if false;
    }

    // ── Parent link requests ──────────────────────────────────────────────────
    // Doc id: {parentId}_{athleteId}. A parent REQUESTS a link; the ATHLETE
    // approves or declines (they know the family situation best). On approval
    // the onParentLinkUpdate Cloud Function writes linkedAthleteIds /
    // linkedParentIds / the parent's school — clients never set those directly.
    match /parentLinks/{linkId} {
      allow read: if isSignedIn()
        && (resource.data.parentId == request.auth.uid
            || resource.data.athleteId == request.auth.uid);
      allow create: if isSignedIn()
        && getUserData().role == 'parent'
        && request.resource.data.parentId == request.auth.uid
        && linkId == request.auth.uid + '_' + request.resource.data.athleteId
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['parentId', 'athleteId', 'parentName',
             'parentEmail', 'athleteName', 'status', 'createdAt']);
      allow update: if isSignedIn()
        && resource.data.athleteId == request.auth.uid
        && resource.data.status == 'pending'
        && changedKeys().hasOnly(['status', 'respondedAt'])
        && request.resource.data.status in ['approved', 'declined'];
      // Parent withdraws (or clears a declined request to ask again); athlete
      // clears one they've handled.
      allow delete: if isSignedIn()
        && (resource.data.parentId == request.auth.uid
            || resource.data.athleteId == request.auth.uid);
    }

    // ── Schools ───────────────────────────────────────────────────────────────
    match /schools/{schoolId} {
      // Head coach creates their school during onboarding; the id is pinned to
      // their uid (matches ownerCreateSchool above).
      allow create: if isSignedIn()
        && schoolId == 'school_' + request.auth.uid
        && getUserData().role == 'admin_coach';
      allow read:   if isSignedIn(); // athletes need to read school during join flow
      // Coaches at the school have full update access. Anyone else who is
      // signed in may update ONLY the pendingAthleteIds / pendingCoachIds
      // arrays — needed by the athlete + assistant coach join flows to
      // request to join, AND by the "Leave team" flow to remove themselves
      // from a pending list when they pick the wrong school. Both additions
      // and removals are permitted; the worst-case griefing risk (a hostile
      // user removing someone else's pending entry) is minor since the
      // affected user can simply re-request to join.
      allow update: if isCoachAtSchool(schoolId)
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['pendingAthleteIds', 'pendingCoachIds'])
        );
      allow delete: if false;
    }

    // ── Runs ──────────────────────────────────────────────────────────────────
    // Athletes write their own runs; any signed-in user can read.
    //
    // TEMP ROLLBACK (2026-06-04): the school-scoped read (ccc1a25) broke every
    // team view — the coach dashboard + athlete leaderboard fetch runs by
    // `userId in [...]` with NO schoolId filter, and "rules are not filters",
    // so Firestore denied those queries wholesale (everyone showed 0 miles).
    // Reverted to open read to restore function. Single-school, so there's no
    // cross-school exposure today. BEFORE multi-school launch, restore the
    // scoped read AND add a `schoolId ==` filter to the team queries
    // (CoachDashboard batchDocsByIds, AthleteDashboard/AthleteAnalytics
    // leaderboard) so the strict rule is satisfiable. See senior-review backlog.
    match /runs/{runId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      // Owner only, and a run can't be reassigned to someone else's log.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow read: if isSignedIn();
    }

    // ── Check-ins (wellness) ──────────────────────────────────────────────────
    // Same multi-school scoping as runs. Only the athlete who owns the
    // check-in can write. Note: weekly check-ins live in a separate collection
    // with stricter (head-coach-only) rules — see /weeklyCheckins below.
    match /checkins/{checkinId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      // TEMP ROLLBACK (2026-06-04) — see /runs above. Same rules-are-not-filters
      // issue: coach checkin queries fetch by schoolId/date but the scoped read
      // tripped on cross-user evaluation. Reverted to open read; re-scope with
      // matching query filters before multi-school.
      allow read: if isSignedIn();
      allow delete: if false;
    }

    // ── Weekly check-ins (athlete → head coach freeform thread) ──────────────
    // Doc ID format: {userId}_{weekStartISO}. Schema includes message,
    // coachReply, and athleteViewedReplyAt. Privacy: only the athlete and the
    // HEAD coach at their school can read. Assistant coaches and parents are
    // excluded by design — these are private athlete→head-coach messages.
    match /weeklyCheckins/{docId} {
      // An athlete can't create the doc with a coach reply already in it.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && !('coachReply' in request.resource.data);
      // Athlete: edit own message + mark reply as read. Cannot write coachReply.
      // Head coach at same school: write/edit coachReply only. Cannot touch
      // the athlete's message text.
      allow update: if isSignedIn() && (
        (resource.data.userId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['coachReply', 'userId', 'schoolId', 'weekStartISO']))
        || (isHeadCoachAtSchool(resource.data.schoolId)
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['userId', 'schoolId', 'weekStartISO', 'message', 'athleteViewedReplyAt']))
      );
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || isHeadCoachAtSchool(resource.data.schoolId)
      );
      allow delete: if false;
    }

    // ── Events (training calendar) ────────────────────────────────────────────
    match /events/{eventId} {
      allow read:   if isSignedIn()
        && belongsToSchool(resource.data.schoolId);
      allow create: if isCoachAtSchool(request.resource.data.schoolId);
      allow update: if isCoachAtSchool(resource.data.schoolId);
      allow delete: if isCoachAtSchool(resource.data.schoolId);
    }

    // ── Groups (training groups) ──────────────────────────────────────────────
    match /groups/{groupId} {
      allow read:   if isSignedIn()
        && belongsToSchool(resource.data.schoolId);
      allow create: if isCoachAtSchool(request.resource.data.schoolId);
      allow update: if isCoachAtSchool(resource.data.schoolId);
      allow delete: if isCoachAtSchool(resource.data.schoolId);
    }

    // ── Weekly Drafts (planner) ───────────────────────────────────────────────
    // Read uses isSignedIn() only — getDoc on non-existent docs fails if we
    // check resource.data.schoolId (resource.data is null for missing docs).
    // Doc ID format schoolId_mondayISO already scopes access.
    match /weeklyDrafts/{draftId} {
      allow read:   if isSignedIn();
      allow create: if isCoachAtSchool(request.resource.data.schoolId);
      allow update: if isCoachAtSchool(resource.data.schoolId);
      allow delete: if isCoachAtSchool(resource.data.schoolId);
    }

    // ── Team Posts (messaging) ────────────────────────────────────────────────
    function canPostToTeamFeed(post) {
      let user = getUserData();
      let ch = post.get('channel', 'whole_team');
      let isCoach = user.role == 'admin_coach' || user.role == 'assistant_coach';
      return post.authorId == request.auth.uid
        && post.authorRole == user.role
        && post.authorName == user.firstName + ' ' + user.lastName
        && user.get('status', 'approved') == 'approved'
        && user.role != 'parent'
        && (isCoach
            || ch == 'whole_team'
            || ((ch == 'boys' || ch == 'girls') && user.get('gender', null) == ch)
            || (ch.matches('group_.+') && ch == 'group_' + user.get('groupId', '')));
    }

    match /teamPosts/{postId} {
      allow read:   if isSignedIn()
        && belongsToSchool(resource.data.schoolId);
      // Approved members only, posting as themselves (author fields must match
      // the poster — the name/role go out in push notifications), to a channel
      // their role may post in. Parents read but never post; the coaches and
      // parents channels are coach-only; boys/girls/group channels need the
      // matching athlete gender/group.
      allow create: if isSignedIn()
        && belongsToSchool(request.resource.data.schoolId)
        && canPostToTeamFeed(request.resource.data);
      allow delete: if isCoachAtSchool(resource.data.schoolId)
        || (isSignedIn() && resource.data.authorId == request.auth.uid);
      allow update: if false;
    }

    // ── Race Meets ────────────────────────────────────────────────────────────
    match /raceMeets/{meetId} {
      allow read:   if isSignedIn()
        && belongsToSchool(resource.data.schoolId);
      allow create: if isCoachAtSchool(request.resource.data.schoolId);
      allow update: if isCoachAtSchool(resource.data.schoolId);
      allow delete: if isCoachAtSchool(resource.data.schoolId);
    }

    // ── Races ─────────────────────────────────────────────────────────────────
    match /races/{raceId} {
      allow read:   if isSignedIn()
        && belongsToSchool(resource.data.schoolId);
      allow create: if isCoachAtSchool(request.resource.data.schoolId);
      allow update: if isCoachAtSchool(resource.data.schoolId);
      allow delete: if isCoachAtSchool(resource.data.schoolId);
    }

    // ── Race Results ──────────────────────────────────────────────────────────
    match /raceResults/{resultId} {
      allow read:   if isSignedIn()
        && belongsToSchool(resource.data.schoolId);
      allow create: if isCoachAtSchool(request.resource.data.schoolId);
      allow update: if isCoachAtSchool(resource.data.schoolId);
      allow delete: if isCoachAtSchool(resource.data.schoolId);
    }

    // ── Daily Messages ────────────────────────────────────────────────────────
    // Doc ID format: schoolId_YYYY-MM-DD
    match /dailyMessages/{messageId} {
      allow read:   if isSignedIn();
      allow create, update: if isSignedIn()
        && isCoachAtSchool(request.resource.data.schoolId);
      allow delete: if false;
    }

    // ── Attendance ────────────────────────────────────────────────────────────
    // Doc ID format: schoolId_athleteId_YYYY-MM-DD.
    // Coaches at the school write. Reads scoped per role:
    //   - Athlete reads own attendance (athleteId field on the doc)
    //   - Same-school users read (coach analytics, teammate visibility)
    //   - Parent reads linked athletes' attendance
    match /attendance/{attendanceId} {
      // TEMP ROLLBACK (2026-06-04) — see /runs above. Reverted to open read;
      // re-scope with matching query filters before multi-school.
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && isCoachAtSchool(request.resource.data.schoolId);
      allow delete: if isSignedIn()
        && isCoachAtSchool(resource.data.schoolId);
    }

    // ── Workout Library ───────────────────────────────────────────────────────
    match /workoutLibrary/{workoutId} {
      allow read:   if isSignedIn()
        && belongsToSchool(resource.data.schoolId);
      allow create: if isCoachAtSchool(request.resource.data.schoolId);
      allow delete: if isCoachAtSchool(resource.data.schoolId);
      allow update: if isCoachAtSchool(resource.data.schoolId);
    }

    // ── Workout overrides (per-athlete injury modification) ───────────────────
    // Doc ID = athleteId (one active "break" per athlete). A coach replaces an
    // athlete's prescribed workout with cross-training or rest for a date range.
    // Open read (matches runs/checkins/attendance convention — athlete reads own,
    // coaches read the team); only a coach at the school can write/clear.
    match /workoutOverrides/{athleteId} {
      allow read:   if isSignedIn();
      allow create, update: if isCoachAtSchool(request.resource.data.schoolId);
      allow delete: if isCoachAtSchool(resource.data.schoolId);
    }

    // ── Garmin OAuth tokens ───────────────────────────────────────────────────
    // Read and written ONLY by Cloud Functions (Admin SDK bypasses rules).
    // Tokens used to live on users/{uid}, which every signed-in user can read.
    // The catch-all below would already deny this; this rule documents intent.
    match /garminTokens/{uid} {
      allow read, write: if false;
    }

    // Pending Garmin OAuth attempts (PKCE verifier keyed by OAuth state).
    // Cloud Functions only.
    match /garminOAuthStates/{state} {
      allow read, write: if false;
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
